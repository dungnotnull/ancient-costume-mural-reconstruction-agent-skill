# Environment template — copy to .env and edit.
# All variables use the ACMR_ prefix. Nested keys use double underscore.

# Optional: explicit path to a JSON/YAML/TOML config file.
ACMR_CONFIG=config/config.json

# LLM parameters
ACMR_LLM__MODEL=claude-sonnet-4-5
ACMR_LLM__TEMPERATURE=0.2
ACMR_LLM__MAX_OUTPUT_TOKENS=4096
ACMR_LLM__MAX_RETRIES=3

# Harness behavior
ACMR_HARNESS__DEFAULT_LANGUAGE=en
ACMR_HARNESS__MAX_GATE_RETRIES=2
ACMR_HARNESS__ENABLE_ROUTER=true
ACMR_HARNESS__ENABLE_HOOKS=true

# Feature flags
ACMR_FEATURES__ENABLE_KNOWLEDGE_CRAWL=true
ACMR_FEATURES__ENABLE_ROUTER_CHAIN_OF_THOUGHT=true
ACMR_FEATURES__ENABLE_EVENT_EMISSION=false

# Logging
ACMR_LOGGING__LEVEL=INFO
ACMR_LOGGING__JSON_FORMAT=false
