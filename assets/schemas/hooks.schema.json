{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ancient-costume-mural-reconstruction/schemas/hooks.schema.json",
  "title": "HookDefinitions",
  "description": "Lifecycle hooks registered for the harness and skills.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "hooks"],
  "properties": {
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "hooks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/HookEntry"}}
  },
  "$defs": {
    "HookEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "event", "handler", "scope"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "event": {"type": "string", "enum": ["pre_skill", "post_skill", "on_error", "on_degradation", "on_gate_fail", "on_event_emit", "pre_harness", "post_harness"]},
        "scope": {"type": "string", "enum": ["harness", "skill", "all"]},
        "handler": {"type": "string", "description": "Python dotted path to the hook handler callable."},
        "priority": {"type": "integer", "default": 0, "description": "Lower priority runs first."},
        "target_skill": {"type": "string", "description": "Restrict to a single skill name when scope=skill."}
      }
    }
  }
}
